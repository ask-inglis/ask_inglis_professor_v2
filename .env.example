# AskInglis professor portal backend settings. Copy this file to backend/.env and fill in real values.
# Never commit .env. Never paste real keys into chat, Trello or the frontend.
# The backend reads this file only when it starts. Restart it after changing a value.
#
# To make a random secret (for the keys and passwords below), run this on your computer
# and paste the result after the = sign:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Student feedback: "live" reads real feedback from the Student Chatbot backend
STUDENT_FEEDBACK_MODE=live
# Where this backend reaches the Student Chatbot backend
STUDENT_CHATBOT_URL=http://127.0.0.1:8002
# Seconds to wait for the Student Chatbot backend (its feedback list can take about 10 seconds)
STUDENT_CHATBOT_TIMEOUT_SECONDS=45

# The first professor login. Pick the professor's email, and make a password with the command above
# (use token_urlsafe(18) for a shorter one). The account is created by: python create_initial_data.py
# After the password is changed in the portal, delete INITIAL_PROFESSOR_PASSWORD from this file.
INITIAL_PROFESSOR_EMAIL=
INITIAL_PROFESSOR_PASSWORD=

# Look for evidence in Wikipedia, PubMed and Europe PMC when checking claims
EXTERNAL_EVIDENCE_ENABLED=true

# Signs the professor's login tokens. Make a random secret with the command above.
# If it changes, everyone is logged out. Keep it private.
JWT_SECRET_KEY=

# Lets this backend call the Student Chatbot's /admin routes.
# It must have the SAME value as ADMIN_API_KEY in the chatbot's backend/.env.
# Make one random secret with the command above and paste it in both places.
STUDENT_CHATBOT_ADMIN_KEY=

# The AI that checks claims. The names say BullsAI, but they currently point to Gemini.
# BULLSAI_API_KEY is a Gemini key: create one at https://aistudio.google.com/apikey
# BULLSAI_BASE_URL is Google's OpenAI-compatible Gemini address (check Google's Gemini API docs if it stops working).
BULLSAI_API_KEY=
BULLSAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
BULLSAI_MODEL=gemini-3.5-flash-lite